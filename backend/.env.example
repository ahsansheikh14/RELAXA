PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/relaxa
NODE_ENV=development
JWT_SECRET=replace_with_strong_secret

# AI chat — Gemini primary, OpenAI optional backup
GEMINI_API_KEY=replace_with_gemini_key
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=replace_with_openai_key
OPENAI_MODEL=gpt-4o-mini

GOOGLE_OAUTH_ENABLED=false
APPLE_OAUTH_ENABLED=false
FRONTEND_URL=http://localhost:5173

# Forgot-password email — Resend (recommended for deploy)
# 1) Sign up: https://resend.com
# 2) API Keys → Create API Key → paste below
# 3) Free test sender: onboarding@resend.dev (can email your Resend account email)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=Relaxa <onboarding@resend.dev>
ALLOW_RESET_LINK_FALLBACK=true

# Optional: Gmail SMTP (only if you do not use Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your.email@gmail.com

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/relaxa
NODE_ENV=development
JWT_SECRET=replace_with_strong_secret

# AI chat — Gemini primary, OpenAI optional backup
GEMINI_API_KEY=replace_with_gemini_key
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=replace_with_openai_key
OPENAI_MODEL=gpt-4o-mini

GOOGLE_OAUTH_ENABLED=false
APPLE_OAUTH_ENABLED=false
FRONTEND_URL=http://localhost:5173

# Email for forgot-password (Gmail example)
# 1) Enable 2FA on Gmail, create App Password at https://myaccount.google.com/apppasswords
# 2) Use that 16-char password as SMTP_PASS (not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your.email@gmail.com
